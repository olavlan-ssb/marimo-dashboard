// See config docs here: https://opencode.ai/v2/docs/config
{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "experimental": {
    "todo": true
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.cache/uv", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/uv/**", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "/buckets/**", "effect": "ask" },
    { "action": "skill", "resource": "marimo-pair", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" }
  ]
}
